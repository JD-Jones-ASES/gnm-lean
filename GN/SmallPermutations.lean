/-- Translate the embedded position permutation into the centered hole convention. -/
def smallPermutation (k j u : ℤ) : ℤ :=
  (smallPermutationValues k.toNat (j+k+1).toNat).getD (u+k).toNat 0 - (k+1)

/-- Finite image coverage and cardinality certify the two required bijections. -/
def SmallPermutationCertificate (k : ℤ) : Prop :=
  ∀ j ∈ Finset.Icc (-k) k,
    (displacementDomain k j).image (smallPermutation k j) = displacementDomain k j ∧
    (displacementDomain k j).image (fun u => smallPermutation k j u-u) =
      (Finset.Icc (-k) k).erase 0 ∧
    (displacementDomain k j).card ≤ ((Finset.Icc (-k) k).erase 0).card

