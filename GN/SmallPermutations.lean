/-- The 435 additional literal certificates cover every hole for k=7,...,21. -/
theorem small_displacement_permutations {k j : ℤ} (hk : 7 ≤ k) (hk' : k ≤ 21)
    (hj : -k ≤ j ∧ j ≤ k) : ∃ σ : ℤ → ℤ, DisplacementPermutation k j σ := by
  have hc : SmallPermutationCertificate k := by
    interval_cases k
    · exact small_certificates_7
    · exact small_certificates_8
    · exact small_certificates_9
    · exact small_certificates_10
    · exact small_certificates_11
    · exact small_certificates_12
    · exact small_certificates_13
    · exact small_certificates_14
    · exact small_certificates_15
    · exact small_certificates_16
    · exact small_certificates_17
    · exact small_certificates_18
    · exact small_certificates_19
    · exact small_certificates_20
    · exact small_certificates_21
  obtain ⟨hσ, hδ, hcard⟩ := hc j (Finset.mem_Icc.mpr hj)
  exact ⟨smallPermutation k j, displacementPermutation_of_images hσ hδ hcard⟩

/-- All 475 explicit finite certificates, including the forty earlier base rows. -/
theorem bounded_displacement_permutations {k j : ℤ} (hk : 3 ≤ k) (hk' : k ≤ 21)
    (hj : -k ≤ j ∧ j ≤ k) : ∃ σ : ℤ → ℤ, DisplacementPermutation k j σ := by
  by_cases hsmall : k ≤ 6
  · exact finite_displacement_permutations hk hsmall hj
  · exact small_displacement_permutations (by omega) hk' hj

